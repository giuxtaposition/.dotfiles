{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "enabledPlugins": {
    "caveman@caveman": true,
    "frontend-design@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "stripe@claude-plugins-official": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "repo": "JuliusBrussee/caveman",
        "source": "github"
      }
    },
    "ponytail": {
      "source": {
        "repo": "DietrichGebert/ponytail",
        "source": "github"
      }
    },
    "ui-ux-pro-max-skill": {
      "source": {
        "repo": "nextlevelbuilder/ui-ux-pro-max-skill",
        "source": "github"
      }
    }
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "tmux set -w -t \"$TMUX_PANE\" @agent-status waiting 2>/dev/null; true",
            "type": "command"
          }
        ],
        "matcher": "permission_prompt|elicitation_dialog"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "tmux set -w -t \"$TMUX_PANE\" @agent-status working 2>/dev/null; true",
            "type": "command"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "rtk hook claude",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "tmux set -w -t \"$TMUX_PANE\" @agent-status done 2>/dev/null; true",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "tmux set -w -t \"$TMUX_PANE\" @agent-status working 2>/dev/null; true",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus[1m]",
  "statusLine": {
    "command": "bash \"/home/giu/.claude/statusline.sh\"",
    "type": "command"
  }
}
